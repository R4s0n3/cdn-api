{
  "name": "upload",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Upload API and public file CDN for cdn.miomideal.com",
  "scripts": {
    "prebuild": "DATABASE_URL=${DATABASE_URL:-postgresql://build:build@127.0.0.1:5432/cdn} prisma generate",
    "build": "tsc",
    "start": "prisma migrate deploy && node dist/main.js",
    "dev": "ts-node-dev --respawn src/main.ts",
    "test": "npm run build && node --test test/*.cjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "multer": "^1.4.5-lts.2",
    "prisma": "^6.8.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  }
}
