    "@types/multer": "^2.2.0",
    "prisma": "^6.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@prisma/client": "^6.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
