# MySQL connection shared with the existing NextAuth / media-handler database.
# This process does not run migrations.
DATABASE_URL=mysql://cdn:change-me@mysql:3306/media

# Must stay the same value used for previous uploads. It selects the hash directory
# for new files. Changing it does not break URLs that were already issued.
SALT_STRING=change-me-to-a-long-random-string

# Absolute path. In Coolify this is the persistent volume mount.
SERVER_ROOT=/data

# Optional. Coolify should expose this same port.
PORT=9001

# Optional. Defaults to 52428800 (50 MiB). Maximum accepted value is 209715200.
# MAX_UPLOAD_BYTES=52428800

# Optional extra browser origins, comma-separated and matched exactly.
# https://miomideal.com and https://*.miomideal.com are always allowed.
# CORS_ORIGINS=https://preview.example.com
