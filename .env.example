NODE_ENV=development
HOST=0.0.0.0
PORT=9001
TRUST_PROXY=1

# Required public origin of this API. Production deployments must use HTTPS.
# Do not add credentials, a path, a query, or a fragment.
PUBLIC_API_BASE_URL=http://localhost:9001

DATABASE_URL=mysql://user:password@localhost:3306/cdn

# Preserve the exact value from the current deployment or legacy storage URLs
# will be assigned to a different cluster for future uploads.
SALT_STRING=replace-with-the-existing-secret

# Hetzner locations are fsn1, nbg1, and hel1. Region and endpoint must match.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=replace-with-your-bucket-name
S3_ACCESS_KEY_ID=replace-with-your-access-key
S3_SECRET_ACCESS_KEY=replace-with-your-secret-key
S3_FORCE_PATH_STYLE=false

# Optional. Leave blank to preserve relative /storage/... URLs and proxy private
# objects through this API. For a public bucket/CDN, set its HTTPS base URL.
S3_PUBLIC_BASE_URL=

# Optional namespace inside the bucket. Existing files must be migrated under it.
S3_KEY_PREFIX=

S3_MAX_ATTEMPTS=3
STORAGE_CACHE_CONTROL=public, max-age=31536000, immutable
READINESS_TIMEOUT_MS=5000

# Temporary staging only; must be absolute and writable by the non-root app user.
# Uploaded files are removed after transfer to S3.
# UPLOAD_TEMP_DIR=/tmp/cdn-api-uploads
