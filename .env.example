# Fresh PostgreSQL database for this CDN. The container runs prisma migrate deploy on start.
DATABASE_URL=postgresql://cdn:change-me@postgres:5432/cdn

# Sent by clients as the X-API-Key header.
CDN_API_KEY=change-me-to-a-long-random-string

# Absolute path. In Coolify this is the persistent volume mount.
SERVER_ROOT=/data

PORT=9001
NODE_ENV=production

# Optional. Defaults to 52428800 (50 MiB). Maximum accepted value is 209715200.
# MAX_UPLOAD_BYTES=52428800

# Optional extra browser origins, comma-separated and matched exactly.
# https://miomideal.com and https://*.miomideal.com are always allowed.
# CORS_ORIGINS=https://preview.example.com

# Optional S3 mode. Leave S3_ENDPOINT unset to keep the default disk storage.
# Set all required S3 values together when enabling it.
# PUBLIC_API_BASE_URL=https://cdn.miomideal.com
# SALT_STRING=preserve-existing-salt
# S3_CLUSTER_USER_ID=cdn
# S3_ENDPOINT=https://nbg1.your-objectstorage.com
# S3_REGION=nbg1
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=false
# S3_KEY_PREFIX=
# S3_PUBLIC_BASE_URL=
# S3_MAX_ATTEMPTS=3
# STORAGE_CACHE_CONTROL=public, max-age=31536000, immutable
# READINESS_TIMEOUT_MS=5000
# UPLOAD_TEMP_DIR=/tmp/cdn-api-uploads
