# Fresh PostgreSQL database for this CDN. The container runs prisma migrate deploy on start.
DATABASE_URL=postgresql://cdn:change-me@postgres:5432/cdn

# Sent by clients as the X-API-Key header.
CDN_API_KEY=change-me-to-a-long-random-string

# Absolute path. In Coolify this is the persistent volume mount.
SERVER_ROOT=/data

PORT=9001
NODE_ENV=production

# Optional. Defaults to 52428800 (50 MiB). Maximum accepted value is 209715200.
# MAX_UPLOAD_BYTES=52428800

# Optional extra browser origins, comma-separated and matched exactly.
# https://miomideal.com and https://*.miomideal.com are always allowed.
# CORS_ORIGINS=https://preview.example.com
